# Copy this file to .env (same folder as launchkit.py) and fill in what you need.
# Real environment variables override values in .env.

# --- Core ---
ADMIN_TOKEN=pick-a-long-random-secret
BASE_URL=http://localhost:8000
PORT=8000
BUMP_PER_REFERRAL=5
# 1 = friends must confirm their email before a referral counts (recommended)
REQUIRE_VERIFICATION=1
SECRET_SALT=change-this-random-string
# 127.0.0.1 = only reachable from this computer / your reverse proxy (recommended).
# Use 0.0.0.0 only if your host requires it (e.g. Docker, Render, Railway).
HOST=127.0.0.1
# 1 = running behind Caddy/nginx, which sets X-Forwarded-For. Leave 0 otherwise.
TRUST_PROXY=0
# IANA time zone for scheduling and stats, e.g. Asia/Jakarta, Europe/Berlin. Empty = this computer's clock.
# (On Windows, named zones need: pip install tzdata)
TIMEZONE=
# Daily database backups (kept: BACKUP_KEEP, 0 = off)
BACKUP_DIR=backups
BACKUP_KEEP=14

# --- Email: set ONE of Resend or SMTP. With neither, emails print to the console. ---
# Resend (https://resend.com): verify your domain, then create an API key
RESEND_API_KEY=
EMAIL_FROM=hello@yourdomain.com
EMAIL_REPLY_TO=

# SMTP (Gmail app password, Postmark, Mailgun, Brevo, SES...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls

# --- AI writer: any OpenAI-compatible API ---
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Free/local alternative with Ollama (no key needed):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# --- Social auto-posting ---
BSKY_HANDLE=
BSKY_APP_PASSWORD=
DISCORD_WEBHOOK=
